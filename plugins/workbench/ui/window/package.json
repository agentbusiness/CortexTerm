  "license": "Apache-2.0",
  "cortex": {
    "id": "workbench.window",
    "slot": "window@1"
  },
  "scripts": {
    "build": "node build.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "devDependencies": {
